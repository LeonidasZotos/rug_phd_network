# App
NEXT_PUBLIC_SITE_NAME="PhD Network Map"
NEXT_PUBLIC_MAP_STYLE_URL="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"
DATA_DIR="./data"
CACHE_TTL_SECONDS="300"
PUBLIC_ID_SECRET="replace-with-a-separate-random-secret-of-at-least-32-characters"
SUPPRESSED_PUBLIC_IDS=""

# Sanitized Sheet shared as "Anyone with the link: Viewer"
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB="Public Profiles"

# Consent is supplied by completing the optional form section, so no row-level field is required.
SHEET_CONSENT_HEADER="I consent to sharing this information publicly on the PhD network website."
REQUIRE_EXPLICIT_CONSENT="false"

# Server-only geocoding. Disabled by default; cached manual overrides still work.
GEOCODING_ENABLED="false"
GEOCODER_USER_AGENT="rug-phd-network/0.1 (phd.council.hum@rug.nl)"
